@PACKAGE_INIT@

# ---------------------------------------------------------------
# FetchContent / add_subdirectory mode
# ---------------------------------------------------------------
if(TARGET tensorflow-lite@TFLLIBRARY_POSTFIX@)
    if(NOT TARGET tensorflow-lite::tensorflow-lite@TFLLIBRARY_POSTFIX@)
        # Use IMPORTED INTERFACE, not ALIAS.
        # An ALIAS to a real target causes install(EXPORT) to require
        # 'ruy' to be in an export set, which it never will be.
        # An IMPORTED target is treated as external and exempt from that check.
        add_library(tensorflow-lite::tensorflow-lite@TFLLIBRARY_POSTFIX@ INTERFACE IMPORTED GLOBAL)
        set_target_properties(tensorflow-lite::tensorflow-lite@TFLLIBRARY_POSTFIX@ PROPERTIES
            INTERFACE_LINK_LIBRARIES "$<BUILD_INTERFACE:tensorflow-lite@TFLLIBRARY_POSTFIX@>"
        )
    endif()
    set(tensorflow-lite@TFLLIBRARY_POSTFIX@_FOUND TRUE)
    set(tensorflow-lite@TFLLIBRARY_POSTFIX@_LIBRARIES tensorflow-lite::tensorflow-lite@TFLLIBRARY_POSTFIX@)

    get_target_property(_tfl_inc tensorflow-lite@TFLLIBRARY_POSTFIX@ INTERFACE_INCLUDE_DIRECTORIES)
    set(tensorflow-lite@TFLLIBRARY_POSTFIX@_INCLUDE_DIRS "${_tfl_inc}")

    return()
endif()

# ---------------------------------------------------------------
# Installed-package mode
# ---------------------------------------------------------------

include(CMakeFindDependencyMacro)

find_dependency(absl)
find_dependency(Eigen3)
find_dependency(flatbuffers)
find_dependency(farmhash)
find_dependency(fft2d)
find_dependency(pthreadpool)
find_dependency(tfl-XNNPACK@LIBRARY_POSTFIX@)
find_dependency(NEON_2_SSE)
find_package(cpuinfo QUIET)
if(NOT cpuinfo_FOUND)
    find_dependency(PkgConfig)
    pkg_check_modules(cpuinfo REQUIRED libcpuinfo)
endif()
find_dependency(ruy)
find_dependency(gemmlowp)

include("${CMAKE_CURRENT_LIST_DIR}/@LIBRARY_NAME@Targets.cmake")
